# Provider build output
bin/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go build / tool caches (should live in GOCACHE / GOPATH, not the repo)
__debug_bin*

# Go workspace file
go.work
go.work.sum

# env file — may contain API keys, secrets, credentials
.env
.env.*
!.env.example
*.env

# Security-sensitive files — private keys, certificates, secrets
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
id_rsa
id_ed25519
id_ecdsa
*.gpg
*.asc
# Common secret/config files developers accidentally commit
secrets.json
secrets.yaml
secrets.yml
secret.tf
credentials.json
credentials.tf
serviceaccount.json

# Editor/IDE artifacts
# VS Code
.vscode/
*.code-workspace
# JetBrains (GoLand, IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
# Eclipse / Che
.classpath
.project
.settings/
.factorypath
# Vim / Neovim
*.swp
*.swo
*~
.netrwhist
# Emacs
\#*\#
.#*
*.elc
# Sublime Text
*.sublime-project
*.sublime-workspace
# macOS Finder metadata
.DS_Store
.AppleDouble
.LSOverride
# Windows desktop.ini
Thumbs.db
desktop.ini

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log
*.log

# Terraform plugin cache
plugin-cache/
.terraform.d/

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
!example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*
*.tfplan

# Local Terraform lock files generated inside example directories
examples/**/.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
*.dot

# Optional: ignore generated documentation files
.sbom/